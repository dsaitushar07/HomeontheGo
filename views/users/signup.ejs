<% layout("/layouts/boilerplate")%>
<br />
<div class="row">
  <div class="col-6 offset-3">
    <h3>Signup here</h3>

    <form method="post" action="/signup" novalidate class="needs-validation">
      <div class="mb-3">
        <label for="username" class="form-label">Username</label>
        <input
          name="username"
          placeholder="kingsnow@123"
          type="text"
          id="username"
          class="form-control"
          required
        />
        <div class="invalid-feedback">Please enter the username</div>

        <div class="valid-feedback">Username Looks good!</div>
      </div>
      <div class="mb-3">
        <label for="email" class="form-label">Email</label>
        <input
          name="email"
          placeholder="kingsnow@123gmail.com"
          type="email"
          id="email"
          class="form-control"
          required
        />
      </div>
      <div class="mb-3">
        <label for="password" class="form-label">Password</label>
        <input
          name="password"
          type="password"
          id="password"
          class="form-control"
          required
        />
      </div>
      <button class="btn btn-dark add-btn">Signup</button>
    </form>
  </div>
</div>
